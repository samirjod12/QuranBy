// Builds catalog.json + config.json from the PDFs inside the two folders. No setup needed.
const fs = require('fs');
const path = require('path');

const repo = process.env.GITHUB_REPOSITORY;           // "you/quranby" (set automatically by GitHub)
const branch = process.env.DEFAULT_BRANCH || 'main';
if (!repo) { console.log('GITHUB_REPOSITORY not set - skipping catalog generation.'); process.exit(0); }

const base = `https://raw.githubusercontent.com/${repo}/${branch}/`;
const enc = (p) => p.split('/').map(encodeURIComponent).join('/');
const IMG = ['.jpg', '.jpeg', '.png', '.webp'];

function scan(folder) {
  if (!fs.existsSync(folder)) return [];
  const files = fs.readdirSync(folder);
  return files
    .filter((f) => f.toLowerCase().endsWith('.pdf'))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
    .map((f) => {
      const stem = f.replace(/\.pdf$/i, '');
      const img = files.find((x) => IMG.includes(path.extname(x).toLowerCase()) && x.replace(/\.[^.]+$/, '').toLowerCase() === stem.toLowerCase());
      return {
        title: stem.replace(/[_-]+/g, ' ').trim(),
        url: base + enc(`${folder}/${f}`),
        thumb: img ? base + enc(`${folder}/${img}`) : '',
      };
    });
}

const catalog = { themes: scan('Quran-Theme'), hadith: scan('Hadith-Books') };
fs.writeFileSync('catalog.json', JSON.stringify(catalog, null, 2) + '\n');
fs.writeFileSync('config.json', JSON.stringify({ catalogUrl: base + 'catalog.json' }, null, 2) + '\n');
console.log(`Quran themes: ${catalog.themes.length}, Hadith books: ${catalog.hadith.length}`);
